rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default safety catch-all deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection test document for boot healthcheck
    match /test/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Authenticated user records and individual workspaces (Open to all logged-in users)
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      match /{allSubcollections=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Shared Workspaces (ensures instantaneous sync between Vercel, mobile, and AI Studio for all logged-in users)
    match /workspaces/{workspaceId} {
      allow read, write: if request.auth != null;
      
      match /{allSubcollections=**} {
        allow read, write: if request.auth != null;
      }
    }

    // PIN-protected cloud vaults
    match /vaults/{vaultId} {
      allow read: if true;
      allow create: if request.resource.data.pinHash is string && request.resource.data.pinHash.size() > 10;
      allow update: if request.resource.data.pinHash == resource.data.pinHash;
      allow delete: if request.resource.data.pinHash == resource.data.pinHash;
    }
  }
}
