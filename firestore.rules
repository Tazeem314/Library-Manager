rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // PIN-protected cloud vault for library sync across devices
    match /vaults/{vaultId} {
      allow read: if true;
      allow create: if request.resource.data.pinHash is string && request.resource.data.pinHash.size() > 10;
      allow update: if request.resource.data.pinHash == resource.data.pinHash;
      allow delete: if request.resource.data.pinHash == resource.data.pinHash;
    }

    // Authenticated user records
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      match /{allSubcollections=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
