{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile for library managers and owners authenticated via Google/Gmail",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Unique user ID" },
        "email": { "type": "string", "description": "User email address" },
        "displayName": { "type": "string", "description": "Display name" },
        "photoURL": { "type": "string", "description": "Avatar photo URL" },
        "createdAt": { "type": "string", "description": "Profile creation timestamp" },
        "lastLoginAt": { "type": "string", "description": "Last login timestamp" }
      },
      "required": ["uid", "email"]
    },
    "WorkspaceData": {
      "title": "WorkspaceData",
      "description": "Full StudySpace application state containing seats, students, shifts, plans, payments, and expenses",
      "type": "object",
      "properties": {
        "business": { "type": "object", "description": "Business profile" },
        "shifts": { "type": "array", "description": "Operating shifts" },
        "plans": { "type": "array", "description": "Membership fee plans" },
        "seats": { "type": "array", "description": "Seat layout and occupancy" },
        "students": { "type": "array", "description": "Student roster" },
        "memberships": { "type": "array", "description": "Membership bookings" },
        "payments": { "type": "array", "description": "Payment logs" },
        "expenses": { "type": "array", "description": "Operating expenses" },
        "updatedAt": { "type": "number", "description": "Timestamp ms of latest update" },
        "updatedAtIso": { "type": "string", "description": "ISO timestamp string" },
        "deviceOrigin": { "type": "string", "description": "Identifier of the client device making the update" }
      },
      "required": ["business", "seats", "students", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile document"
    },
    "/users/{userId}/workspace/data": {
      "schema": "WorkspaceData",
      "description": "User workspace document"
    },
    "/workspaces/{workspaceId}": {
      "schema": "WorkspaceData",
      "description": "Shared cross-device workspace document for real-time synchronization across Vercel and AI Studio"
    }
  }
}
